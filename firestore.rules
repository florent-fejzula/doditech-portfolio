rules_version = '2';

// Contact-form enquiries only. Anyone may submit one; nobody may read,
// edit or delete them from the client — you read them in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['name', 'email', 'company', 'body', 'receivedAt', 'referrer', 'locale'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() < 5000;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
